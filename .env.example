NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=https://recruitment-fti.aerisbeaute.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Also enable Google Calendar API (calendar-json.googleapis.com), not CalDAV.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=HR Recruitment
# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=generate-a-long-random-string
LARK_APP_ID=
LARK_APP_SECRET=
# International Lark: https://open.larksuite.com
# Feishu (China): https://open.feishu.cn
LARK_API_BASE=https://open.larksuite.com
LARK_APPROVAL_CODE=hr_recruitment_request

# Cloudflare Turnstile — local dummy keys always pass.
# Production: set real keys on Vercel (NEXT_PUBLIC_TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
